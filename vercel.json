{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "myalumni-frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "myalumni-backend": {
      "root": "backend",
      "framework": "flask",
      "entrypoint": "run:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "myalumni-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "myalumni-frontend"
      }
    }
  ]
}
