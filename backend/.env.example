APP_ENV=development
FLASK_DEBUG=0
FLASK_SECRET_KEY=dev_myalumni_secret_key_change_in_production

BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:5000

# Database Driver Selection ('sqlite' for local development, 'supabase' / 'postgres' for cloud production)
DB_ENGINE=sqlite
SQLITE_DB_PATH=./myalumni.db
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres

# SMTP Settings & 6-Digit OTP Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MyAlumni
SMTP_USE_TLS=true

OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# CORS: Localhost and Cloudflare tunnels allowed
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.trycloudflare.com
# Upload Size & Storage Configuration
UPLOAD_MAX_SIZE_MB=10

# Universal Storage Driver ('local' or 'supabase')
# - 'local': Saves uploads to server disk (backend/static/uploads). Perfect for localhost development (100% offline).
# - 'supabase': Uploads to Supabase Cloud Object Storage. Required for production deployment on Render/AWS/GCP so uploads survive redeployments.
STORAGE_PROVIDER=local
STORAGE_ROOT=

# Supabase Cloud Storage (Required ONLY when STORAGE_PROVIDER=supabase)
# NOTE: Never put real service_role keys into git or frontend code.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLIC_BUCKET=myalumni-public
SUPABASE_PRIVATE_BUCKET=myalumni-private

DEMO_SEEDING_ENABLED=true
DEMO_PASSWORD=Demo@MyAlumni2026!
