# MyAlumni frontend local-development configuration
VITE_APP_NAME=MyAlumni
VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1

# For the separate Vercel frontend project, set this in Vercel Project Settings:
# VITE_API_BASE_URL=https://YOUR-BACKEND-PROJECT.vercel.app/api/v1
#
# VITE_* values are embedded into the frontend at build time.
# Redeploy the frontend after changing VITE_API_BASE_URL.
# Never put DATABASE_URL, SMTP credentials, JWT secrets or Supabase service keys here.
